# Local development only. Copy to .env; never commit real credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/chapter
DATABASE_USERNAME=chapter
DATABASE_PASSWORD=chapter-local-only
DEMO_ENABLED=true
COOKIE_SECURE=false
# Hosted Neon example (supply username and password separately):
# DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require
